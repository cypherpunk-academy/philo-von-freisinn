#!/usr/bin/env bash
# Pre-commit hook: regenerate output when YAML source changes

if git diff --cached --name-only | grep -q 'projects/Band 2 - Gesundheit und Krankheit des Sozialen/content/.*\.yaml'; then
  echo "▶ Soziale Gesundheit YAML changed — regenerating JPG..."
  cd "projects/Band 2 - Gesundheit und Krankheit des Sozialen"
  python3 scripts/generate-a0.py
  if [ $? -eq 0 ]; then
    git add output/
    echo "✓ Output regenerated and staged"
  else
    echo "✗ Generation failed — commit aborted"
    exit 1
  fi
fi
